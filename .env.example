# Application
NODE_ENV=development
APP_NAME=Ticket Take It
FRONTEND_URL=http://localhost:5173
API_PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL (local Docker defaults; change for your environment)
DATABASE_URL=postgresql://ticket_take_it:change_me_local_only@localhost:5432/ticket_take_it?schema=public

# Redis (used in a later milestone)
REDIS_URL=redis://localhost:6379

# Auth secrets: generate strong random values before implementing authentication.
# Do not reuse examples or commit real secrets.
SESSION_SECRET=replace_with_a_long_random_secret
TOKEN_SIGNING_SECRET=replace_with_a_different_long_random_secret

# Email provider configuration will be added when email delivery is implemented.
# PAYMENT_PROVIDER credentials will be added per provider integration.
