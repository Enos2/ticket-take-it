NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL="PASTE-YOUR-NEON-URL-HERE"

JWT_ACCESS_SECRET=super-secret-access-key-change-me-in-production-12345
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me-in-production-67890
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Email (blank key = emails are printed in the terminal instead of sent)
APP_URL=http://localhost:5173
EMAIL_FROM="Ticket Take It <onboarding@resend.dev>"
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=false

# Mock payments, for testing without a real provider (disabled automatically in production)
PAYMENT_WEBHOOK_SECRET=mock_signature_123

# M-Pesa (Safaricom Daraja). Leave all of these blank until you have sandbox credentials.
# PUBLIC_API_URL must be a public https address of this API (use a tunnel such as ngrok), not localhost.
PUBLIC_API_URL=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=