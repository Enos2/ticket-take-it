// ==========================================
// FILE: backend/prisma/schema.prisma
// PURPOSE: Defines the PostgreSQL database schema.
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  MUSIC
  NIGHTLIFE
  ARTS
  SPORTS
  CONFERENCE
  FOOD
  FAMILY
  COMMUNITY
  OTHER
}

enum LedgerType {
  SALE
  FEE
  REFUND
  FEE_REFUND
  PAYOUT
}

enum PayoutMethod {
  MPESA
  BANK
  OTHER
}
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
  TAKEN_DOWN
}

enum TicketTier {
  EARLY_BIRD
  REGULAR
  VIP
  VVIP
  GROUP
}

enum OrderStatus {
  PENDING
  RESERVED
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  MPESA
  MANUAL
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  VOID
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role           @default(USER)
  emailVerified Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerProfile SellerProfile?
  orders        Order[]
  tickets       Ticket[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  type      EmailTokenType
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

model SellerProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  businessEmail String
  businessPhone String?
  payoutMethod  String?
  payoutDetails String?
  payoutUpdatedAt DateTime?
  feeBps        Int?
  status        SellerStatus @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        Event[]
  ledgerEntries LedgerEntry[]
  payouts       Payout[]
}

model Event {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  slug         String        @unique
  description  String
  venue        String
  city         String
  country      String
  startsAt     DateTime
  endsAt       DateTime
  bannerUrl    String?
  status       EventStatus   @default(DRAFT)
  category     EventCategory @default(OTHER)
  submittedAt  DateTime? // when the seller last sent it for review
  reviewedAt   DateTime? // when an admin last decided
  reviewedById String? // the admin who decided
  reviewNote   String? // why it was rejected or taken down
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ticketTypes  TicketType[]
  tickets      Ticket[]

  @@index([sellerId])
  @@index([status, startsAt])
  @@index([category])
}

model TicketType {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  tier         TicketTier   @default(REGULAR)
  priceCents   Int
  currency     String       @default("USD")
  quantity     Int
  sold         Int          @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isGroup      Boolean      @default(false)
  minGroupSize Int?
  maxGroupSize Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orderItems   OrderItem[]
  tickets      Ticket[]

  @@index([eventId, tier])
}

model Order {
  id                   String      @id @default(cuid())
  reference            String      @unique
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalCents           Int
  currency             String      @default("USD")
  reservationExpiresAt DateTime?
  paidAt               DateTime?
  refundedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  tickets              Ticket[]

  @@index([userId])
  @@index([status])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String     @id @default(cuid())
  orderId        String
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int
  tickets        Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

// One row per admitted person. `code` is a random secret that goes in the QR.
model Ticket {
  id            String       @id @default(cuid())
  code          String       @unique
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  checkedInById String?
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([eventId, status])
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String          @default("USD")
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([provider, providerRef, status])
  @@index([orderId])
  @@index([providerRef])
}
// ==========================================
// END OF FILE: backend/prisma/schema.prisma
// ==========================================
// Every movement of a seller's money. Positive adds to what the seller is owed, negative takes away.
model LedgerEntry {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  payoutId    String?
  payout      Payout?       @relation(fields: [payoutId], references: [id])
  type        LedgerType
  amountCents Int
  currency    String
  feeBps      Int? // the commission rate that was used, kept for the record
  availableAt DateTime // from this moment the entry counts as money that can be paid out
  description String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([orderId, sellerId, type]) // an order can only be posted once per seller and type
  @@index([sellerId, currency, availableAt])
  @@index([orderId])
}

// A payment from the platform to a seller, recorded after the money was sent.
model Payout {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
  amountCents   Int
  currency      String
  method        PayoutMethod
  reference     String? // for example the M-Pesa receipt
  note          String?
  paidById      String
  createdAt     DateTime      @default(now())
  ledgerEntries LedgerEntry[]

  @@index([sellerId, createdAt])
}
// Emails waiting to be sent, or that could not be sent. The text of an email that was sent is wiped.
model EmailOutbox {
  id            String      @id @default(cuid())
  toEmail       String
  subject       String
  html          String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// A permanent record of who did what. It has no links to other tables, so it survives deleted accounts.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String // for example "event.approve"
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
  @@index([action])
}