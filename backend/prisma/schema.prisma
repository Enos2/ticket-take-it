// ==========================================
// FILE: backend/prisma/schema.prisma
// PURPOSE: Defines the PostgreSQL database schema.
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  MUSIC
  NIGHTLIFE
  ARTS
  SPORTS
  CONFERENCE
  FOOD
  FAMILY
  COMMUNITY
  OTHER
}

enum LedgerType {
  SALE
  FEE
  REFUND
  FEE_REFUND
  PAYOUT
}

enum PayoutMethod {
  MPESA
  BANK
  OTHER
}
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  USER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
  TAKEN_DOWN
}

enum TicketTier {
  EARLY_BIRD
  REGULAR
  VIP
  VVIP
  GROUP
}

enum OrderStatus {
  PENDING
  RESERVED
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  MPESA
  MANUAL
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TicketStatus {
  VALID
  USED
  VOID
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  staffRoles StaffMember[]
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role           @default(USER)
  emailVerified Boolean        @default(false)
  termsAcceptedAt DateTime?
  deletedAt     DateTime?
  notifyReminders Boolean      @default(true)
  notifyNewEvents Boolean      @default(true)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerProfile SellerProfile?
  orders        Order[]
  tickets       Ticket[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  favorites     Favorite[]
  follows       Follow[]
  transfersSent     TicketTransfer[] @relation("TransfersSent")
  transfersReceived TicketTransfer[] @relation("TransfersReceived")

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  type      EmailTokenType
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

model SellerProfile {
  staff StaffMember[]
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String
  businessEmail String
  businessPhone String?
  payoutMethod  String?
  payoutDetails String?
  payoutUpdatedAt DateTime?
  feeBps        Int?
  status        SellerStatus @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        Event[]
  ledgerEntries LedgerEntry[]
  payouts       Payout[]
  followers     Follow[]
}

model Event {
  gates Gate[]
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  slug         String        @unique
  description  String
  venue        String
  city         String
  country      String
  startsAt     DateTime
  endsAt       DateTime
  bannerUrl    String?
  maxCapacity  Int? // the most people the event can hold. When it is reached the event is SOLD_OUT. Empty means the ticket quantities are the only limit.
  status       EventStatus   @default(DRAFT)
  category     EventCategory @default(OTHER)
  submittedAt  DateTime? // when the seller last sent it for review
  announcedAt  DateTime? // when followers were told about it
  favorites    Favorite[]
  reviewedAt   DateTime? // when an admin last decided
  reviewedById String? // the admin who decided
  reviewNote   String? // why it was rejected or taken down
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ticketTypes  TicketType[]
  tickets      Ticket[]
  seatSections SeatSection[]

  @@index([sellerId])
  @@index([status, startsAt])
  @@index([category])
}

model TicketType {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  tier         TicketTier   @default(REGULAR)
  priceCents   Int
  currency     String       @default("USD")
  quantity     Int
  sold         Int          @default(0) // unpaid holds, paid tickets and complimentary tickets
  hostReserved Int          @default(0) // tickets held back from public sale for the seller to give out
  hostIssued   Int          @default(0) // how many of the held-back tickets were already given out (also counted in sold)
  startsAt     DateTime?
  endsAt       DateTime?
  isGroup      Boolean      @default(false)
  minGroupSize Int?
  maxGroupSize Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orderItems   OrderItem[]
  tickets      Ticket[]
  seatSections SeatSection[] // when there are sections, this ticket type is sold by seat

  @@index([eventId, tier])
}

model Order {
  id                   String      @id @default(cuid())
  reference            String      @unique
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING)
  totalCents           Int
  currency             String      @default("USD")
  reservationExpiresAt DateTime?
  paidAt               DateTime?
  refundedAt           DateTime?
  isComp               Boolean     @default(false) // a free ticket given out by the seller, not bought
  compIssuedById       String? // the user who gave it out
  compNote             String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  tickets              Ticket[]
  seats                OrderSeat[] // the seats the buyer picked, kept even after the order is cancelled

  @@index([userId])
  @@index([status])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String     @id @default(cuid())
  orderId        String
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int
  tickets        Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

// One row per admitted person. `code` is a random secret that goes in the QR.
model Ticket {
  gateId String?
  gate   Gate?   @relation(fields: [gateId], references: [id], onDelete: SetNull)
  id            String       @id @default(cuid())
  code          String       @unique
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String // the person who holds the ticket now. It changes when a transfer is accepted
  user          User         @relation(fields: [userId], references: [id])
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  checkedInById String?
  transferCount Int          @default(0) // how many times the ticket changed hands
  transfers     TicketTransfer[]
  seat          Seat? // the assigned seat, if the ticket type is sold by seat. A database trigger frees it when the ticket is voided
  createdAt     DateTime     @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([eventId, status])
}

// A ticket offered to another person. Only one can be PENDING per ticket (enforced by a partial index in the migration).
model TicketTransfer {
  id          String         @id @default(cuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUserId  String
  from        User           @relation("TransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toEmail     String // lowercase. Whoever signs in with this verified email can accept
  toUserId    String? // filled in when it is accepted
  to          User?          @relation("TransfersReceived", fields: [toUserId], references: [id], onDelete: SetNull)
  status      TransferStatus @default(PENDING)
  message     String?
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([toEmail, status])
  @@index([fromUserId, status])
  @@index([ticketId])
  @@index([status, expiresAt])
}

// A named block of seats (for example "Floor" or "Balcony"). Every seat in it is sold at its ticket type's price.
model SeatSection {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  name         String
  sortOrder    Int        @default(0)
  seats        Seat[]

  @@unique([eventId, name])
  @@index([ticketTypeId])
}

// One seat. It is free when it has no ticket, is not blocked, and has no live hold.
model Seat {
  id            String      @id @default(cuid())
  eventId       String
  sectionId     String
  section       SeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  row           String // A, B, ... Z, AA ...
  number        Int // 1, 2, 3 ... within the row
  isBlocked     Boolean     @default(false) // kept off public sale for the seller to give out
  heldByOrderId String? // the unpaid order holding this seat
  heldUntil     DateTime? // the hold counts as free after this moment, even if the order was not released yet
  ticketId      String?     @unique // the ticket that occupies the seat. Cleared by a database trigger when the ticket is voided
  ticket        Ticket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  orderSeats    OrderSeat[]

  @@unique([sectionId, row, number])
  @@index([eventId])
  @@index([heldByOrderId])
}

// Which seats an order picked. Kept for good, so a late payment can try to get the same seats again.
model OrderSeat {
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seatId  String
  seat    Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([orderId, seatId])
  @@index([seatId])
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  amountCents Int
  currency    String          @default("USD")
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([provider, providerRef, status])
  @@index([orderId])
  @@index([providerRef])
}

// Every movement of a seller's money. Positive adds to what the seller is owed, negative takes away.
model LedgerEntry {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  payoutId    String?
  payout      Payout?       @relation(fields: [payoutId], references: [id])
  type        LedgerType
  amountCents Int
  currency    String
  feeBps      Int? // the commission rate that was used, kept for the record
  availableAt DateTime // from this moment the entry counts as money that can be paid out
  description String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([orderId, sellerId, type]) // an order can only be posted once per seller and type
  @@index([sellerId, currency, availableAt])
  @@index([orderId])
}

// A payment from the platform to a seller, recorded after the money was sent.
model Payout {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id])
  amountCents   Int
  currency      String
  method        PayoutMethod
  reference     String? // for example the M-Pesa receipt
  note          String?
  paidById      String
  createdAt     DateTime      @default(now())
  ledgerEntries LedgerEntry[]

  @@index([sellerId, createdAt])
}
// Emails waiting to be sent, or that could not be sent. The text of an email that was sent is wiped.
model EmailOutbox {
  id            String      @id @default(cuid())
  toEmail       String
  subject       String
  html          String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// A permanent record of who did what. It has no links to other tables, so it survives deleted accounts.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String // for example "event.approve"
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
  @@index([action])
}
// Events a person has saved.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

// Organisers a person follows.
model Follow {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, sellerId])
  @@index([sellerId])
}

// Remembers who has already had the reminder for an event, so nobody gets it twice.
model EventReminder {
  eventId String
  userId  String
  sentAt  DateTime @default(now())

  @@id([eventId, userId])
}
// People an organiser has added to their door team. They can scan tickets and watch live attendance, nothing else.
model StaffMember {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  email     String // always lowercase
  userId    String? // filled in once a verified account with this email exists
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedById String
  createdAt DateTime      @default(now())
  revokedAt DateTime?

  @@unique([sellerId, email])
  @@index([userId])
  @@index([email])
}

// A named entrance for one event. An empty allowedTiers list admits every ticket type.
model Gate {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  allowedTiers TicketTier[] @default([])
  createdAt    DateTime     @default(now())
  tickets      Ticket[]

  @@unique([eventId, name])
}
// ==========================================
// END OF FILE: backend/prisma/schema.prisma
// ==========================================