// ==========================================
// FILE: backend/tsconfig.json
// PURPOSE: Updated the module resolution to fix global CommonJS import errors.
// ==========================================

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}



// ==========================================
// END OF FILE: backend/tsconfig.json
// LOCATION: backend/tsconfig.json
