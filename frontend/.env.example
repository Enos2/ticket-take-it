# ==========================================
# FILE: frontend/.env.example
# PURPOSE: Frontend settings. Copy to .env if you need to change anything.
# ==========================================

# Leave blank in development: the Vite proxy forwards /api to http://localhost:5000.
# In production, set the full URL of your API, for example:
# VITE_API_URL=https://your-api.onrender.com/api/v1
VITE_API_URL=

# Shown in the legal pages and the Help page.
VITE_COMPANY_NAME=
VITE_SUPPORT_EMAIL=

# The legal pages show a "draft" banner until you set this to true. Do that only after a lawyer has read them.
VITE_LEGAL_REVIEWED=false

# ==========================================
# END OF FILE: frontend/.env.example
# ==========================================